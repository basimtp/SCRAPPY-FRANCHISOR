<body>
<div class="app">
<aside class="sidebar" id="sidebar"><button class="mobile-close" aria-label="Close navigation" id="closeNav">×</button><div class="logo"><img src="./scrappy-logo.png" alt="Scrappy"></div><div class="workspace">Franchisor workspace</div><div class="navcaption">COMMAND CENTRE</div><nav class="nav" aria-label="Main navigation" id="nav"></nav><div class="sidebar-bottom"><div class="demo-note"><b>Interactive demo</b>Synthetic data. Changes stay in this browser. No money or messages are sent.</div><div class="user"><div class="avatar">AK</div><div><b>Admin workspace</b><small>Head office · Kerala</small></div></div></div></aside>
<main class="main"><header class="topbar"><button class="btn menu-toggle" id="openNav" aria-label="Open navigation">☰ Menu</button><div class="breadcrumbs">Scrappy HQ <span>/</span> <b id="crumb">Overview</b></div><div class="topright"><span class="pill demo">DEMO WORKSPACE</span><span class="date" style="font-size:12px;color:var(--muted)">28 September 2026</span><div class="avatar" style="width:31px;height:31px;font-size:11px">HQ</div></div></header>
<div class="content"><div class="heading"><div><div class="eyebrow">LOCAL OPERATIONS. CENTRAL VISIBILITY.</div><h1 id="title">Your network, at a glance.</h1><p class="subtitle" id="subtitle"></p></div><div class="actions"><button class="btn" id="export">↓ Export CSV</button><button class="btn primary" id="newLead">+ Add prospect</button></div></div>
<div class="filters"><label>Territory<select id="territory"><option value="all">All territories</option><option>Thrikkakara</option><option>Ernakulam</option><option>Kalamassery</option><option>Thripunithura</option><option>Aluva</option></select></label><label>Reporting period<select id="period"><option value="7">22–28 Sep 2026</option><option value="1">28 Sep 2026</option><option value="3">26–28 Sep 2026</option></select></label><label class="search">Search this workspace<input id="search" type="search" placeholder="Pickup, customer, territory or prospect…"></label></div>
<div class="filter-summary" id="scope" aria-live="polite"></div><div id="view"></div><footer class="bottomnote"><span>Demonstration only · Illustrative operations, identities and amounts</span><button class="link" id="reset" style="font-size:10px">Reset demo changes</button></footer></div></main></div>
<dialog id="dialog" aria-labelledby="dialogTitle"><div class="modalhead"><div><div class="eyebrow" id="dialogKicker">TRANSACTION DETAILS</div><h2 id="dialogTitle"></h2></div><button class="close" id="closeModal" aria-label="Close dialog">×</button></div><div class="modalbody" id="dialogBody"></div></dialog><div class="toast" id="toast" role="status" aria-live="polite"></div>
<script>
'use strict';
const icons={overview:'M3 3h7v7H3z M14 3h7v7h-7z M3 14h7v7H3z M14 14h7v7h-7z',collections:'M1 5h13v12H1z M14 9h4l4 4v4h-8 M6 21a3 3 0 1 0 0-6 3 3 0 0 0 0 6 M18 21a3 3 0 1 0 0-6 3 3 0 0 0 0 6',network:'M12 3v6 M4 15V9h16v6 M1 15h6v6H1z M9 15h6v6H9z M17 15h6v6h-6z M9 1h6v5H9z',risk:'M12 3 2 21h20L12 3z M12 9v5 M12 17v1',settlements:'M3 5h18v16H3z M3 9h18 M15 13h6v4h-6z',stock:'M3 7 12 2l9 5v11l-9 5-9-5V7z M3 7l9 5 9-5 M12 12v11',audit:'M5 3h14v18H5z M8 8h8 M8 12h8 M8 16h5',weight:'M5 8h14l3 13H2L5 8z M9 8V5a3 3 0 0 1 6 0v3',check:'m4 12 5 5L20 6'};
const ico=n=>`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="${icons[n]||icons.overview}"/></svg>`;
const names=['Thrikkakara','Ernakulam','Kalamassery','Thripunithura','Aluva'];
const clients=['Cedar Apartments','Harbour Office Park','Northside Traders','Lakeview Residents','Metro Print Studio','Orchard Heights','Bayfront Stores','Civic Workspace','Palm Court Society','Station Road Retail','Garden View Homes','Westend Packaging'];
const data=Array.from({length:30},(_,i)=>{const kg=60+((i*73)%390),day=22+(i%7),stage=i%9===0?'In transit':i%7===0?'Collected':'Received',received=stage==='Received'?kg-(i%8===0?18:i%11===0?9:0):null,rate=12+(i%4)*7;return{id:'SCP-'+(1041+i),territory:names[i%5],customer:clients[i%12],day,date:`2026-09-${day}`,kg,received,rate,amount:kg*rate,payment:i%10===0?'Pending':i%13===0?'Mismatch':'Verified',stage,material:['Paper','Metal','Plastic','Mixed dry scrap'][i%4],collector:['Arun K.','Maya R.','Vivek S.','Nisha P.','Rahul M.'][i%5],vehicle:'KL 07 '+['CJ 2041','DA 1062','CM 4083'][i%3],dispatch:received!==null&&i%3!==0?Math.floor(received*.7):0,buyer:['West Coast Materials','Circular Paper Mills','Kerala Recovery Works'][i%3],buyerPaid:i%4!==0}});
const baseLeads=[{id:'FR-201',name:'Anil Menon',territory:'Aluva',stage:'Qualified',budget:'₹18–22 lakh',note:'Logistics operator; warehouse inspection pending.',created:24},{id:'FR-202',name:'Sara Thomas',territory:'Thrikkakara',stage:'Discovery visit',budget:'₹20–25 lakh',note:'Centre visit scheduled. Review working capital.',created:25},{id:'FR-203',name:'Greenline Enterprises',territory:'Ernakulam',stage:'Due diligence',budget:'₹25–30 lakh',note:'Validate references and local operating manager.',created:27},{id:'FR-204',name:'Ravi Nair',territory:'Kalamassery',stage:'New enquiry',budget:'To confirm',note:'Initial qualification call required.',created:28},{id:'FR-205',name:'Meera Joseph',territory:'Thripunithura',stage:'Qualified',budget:'₹15–20 lakh',note:'Existing facility-management experience.',created:26}];
const baseAudit=[{time:'28 Sep · 10:42',actor:'Central finance',action:'Demo bank reconciliation completed for verified payments.',ref:'FIN-028'},{time:'28 Sep · 10:18',actor:'Warehouse lead',action:'Receipt weights recorded; differences routed for review.',ref:'WH-028'},{time:'28 Sep · 09:05',actor:'Head office',action:'Demonstration dataset loaded. No external systems connected.',ref:'DEMO'}];
const KEY='scrappy-franchisor-demo-v1';let local={reviews:{},leads:[],audit:[]};try{const s=JSON.parse(localStorage.getItem(KEY));if(s&&s.reviews&&Array.isArray(s.leads)&&Array.isArray(s.audit))local=s}catch{}
let current='overview',riskFilter='Open',paymentFilter='All',toastTimer;const $=id=>document.getElementById(id);const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));const money=n=>'₹'+Math.round(n).toLocaleString('en-IN'),num=n=>n.toLocaleString('en-IN');
function save(){try{localStorage.setItem(KEY,JSON.stringify(local))}catch{toast('Browser storage unavailable. Changes will last only for this session.')}}
function toast(s){$('toast').textContent=s;clearTimeout(toastTimer);toastTimer=setTimeout(()=>$('toast').textContent='',4000)}
function log(action,ref){local.audit.unshift({time:new Date().toLocaleString('en-IN',{day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'}),actor:'Demo HQ admin',action,ref});save()}
const cfg={overview:['Overview','Your network, at a glance.','Collections, cash and controls across your franchise network.'],collections:['Collections','Every pickup. Fully traceable.','Follow the customer, weight, payment and warehouse handover.'],network:['Franchise network','Build a stronger local network.','Monitor operating territories and manage prospective partners.'],risk:['Risk & exceptions','Focus on what needs a closer look.','An alert is a review signal, not a finding of fraud.'],stock:['Stock reconciliation','Know where every kilogram stands.','Collection-to-warehouse matching and recorded stock movement.'],settlements:['Settlements','Keep the money trail clear.','Customer payouts and buyer receivables, tracked separately.'],audit:['Audit trail','A history of decisions and changes.','Demonstration activity log. Production requires protected, server-side records.']};
function allRisks(){let a=[];for(const d of data){if(d.received!==null&&d.kg!==d.received)a.push({id:'WT-'+d.id,row:d,type:'Weight discrepancy',severity:'High',detail:`${d.kg-d.received} kg difference at warehouse receipt`,value:money((d.kg-d.received)*d.rate)});if(d.payment!=='Verified')a.push({id:'PAY-'+d.id,row:d,type:d.payment==='Mismatch'?'Payment mismatch':'Payment unverified',severity:d.payment==='Mismatch'?'High':'Medium',detail:d.payment==='Mismatch'?'Recorded amount differs from payment reference':'Customer payout has no verified receipt',value:money(d.amount)})}return a}
function matches(d){return($('territory').value==='all'||d.territory===$('territory').value)&&d.day>=29-Number($('period').value)&&Object.values(d).join(' ').toLowerCase().includes($('search').value.trim().toLowerCase())}
function rows(){return data.filter(matches)}
function risks(){return allRisks().filter(x=>matches(x.row))}
function status(s){return `<span class="pill ${['Verified','Received','Paid','Reviewed'].includes(s)?'green':['Mismatch','High'].includes(s)?'red':['Pending','In transit','Medium','Open','In review'].includes(s)?'amber':'gray'}">${esc(s)}</span>`}
function stat(label,value,foot,icon,cl=''){return `<div class="stat"><div class="stat-label">${label}${ico(icon)}</div><div class="stat-value">${value}</div><small class="${cl}">${foot}</small></div>`}
function nav(){const count=allRisks().filter(x=>local.reviews[x.id]?.status!=='Reviewed').length;$('nav').innerHTML=Object.entries(cfg).map(([k,v])=>`<button data-nav="${k}" class="${current===k?'active':''}" ${current===k?'aria-current="page"':''}>${ico(k)}${v[0]}${k==='risk'?`<span class="count">${count}</span>`:''}</button>`).join('')}
function collectionTable(a,limit){const b=limit?a.slice(0,limit):a;return `<div class="tablewrap"><table><thead><tr><th>Pickup / customer</th><th>Territory</th><th class="num">Collected</th><th class="num">Payout</th><th>Payment</th><th>Material status</th><th></th></tr></thead><tbody>${b.map(d=>`<tr><td><button class="link" data-pickup="${d.id}">${d.id}</button><small>${d.customer}</small></td><td>${d.territory}<small>${d.day} Sep 2026</small></td><td class="num">${num(d.kg)} kg</td><td class="num">${money(d.amount)}</td><td>${status(d.payment)}</td><td>${status(d.stage)}</td><td><button class="link" data-pickup="${d.id}" aria-label="View ${d.id}">View ↗</button></td></tr>`).join('')}</tbody></table></div>${!b.length?'<div class="empty">No collections match these filters.</div>':''}<div class="tablefoot"><span>${b.length} of ${a.length} matching pickups</span><span>Amounts in INR</span></div>`}
function chart(a){const start=29-Number($('period').value),days=Array.from({length:29-start},(_,i)=>start+i),v=days.map(d=>a.filter(r=>r.day===d).reduce((s,r)=>s+r.kg,0)),r=days.map(d=>a.filter(x=>x.day===d).reduce((s,x)=>s+(x.received||0),0)),max=Math.max(...v,100),top=Math.ceil(max/500)*500;const x=i=>48+i*(550/Math.max(days.length-1,1)),y=n=>176-n/top*140;const pts=b=>b.map((n,i)=>`${x(i)},${y(n)}`).join(' ');return `<svg class="chart" viewBox="0 0 640 218" role="img" aria-label="Daily collected and warehouse received weight in kilograms for the selected records"><title>Daily collected and received weights</title>${[0,1,2].map(i=>{let n=top*i/2;return `<line x1="48" x2="604" y1="${y(n)}" y2="${y(n)}" stroke="#eeece8"/><text x="38" y="${y(n)+4}" text-anchor="end">${n}</text>`}).join('')}<text x="10" y="17">kg</text><polygon points="${x(0)},176 ${pts(v)} ${x(v.length-1)},176" fill="#8b1e320c"/><polyline points="${pts(r)}" fill="none" stroke="#93aaa4" stroke-width="2.5" stroke-dasharray="5 4"/><polyline points="${pts(v)}" fill="none" stroke="#8b1e32" stroke-width="3"/>${v.map((n,i)=>`<circle cx="${x(i)}" cy="${y(n)}" r="4" fill="#8b1e32"><title>${days[i]} Sep: ${n} kg collected; ${r[i]} kg received</title></circle><text x="${x(i)}" y="205" text-anchor="middle">${days[i]} Sep</text>`).join('')}</svg>`}
function overview(a){let total=a.reduce((s,d)=>s+d.kg,0),verified=a.filter(d=>d.payment==='Verified'),open=risks().filter(r=>local.reviews[r.id]?.status!=='Reviewed'),diff=a.reduce((s,d)=>s+(d.received===null?0:d.kg-d.received),0);return `<div class="stats">${stat('Collected weight',num(total)+' <span style="font-size:17px">kg</span>',`${a.length} recorded pickups`,'weight')}${stat('Verified customer payouts',money(verified.reduce((s,d)=>s+d.amount,0)),`${verified.length} of ${a.length} payments verified`,'settlements','good')}${stat('Receipt weight difference',num(diff)+' <span style="font-size:17px">kg</span>','Excludes material awaiting receipt','stock',diff?'warn':'good')}${stat('Open exceptions',open.length,'Review signals · not confirmed fraud','risk',open.length?'warn':'good')}</div><div class="grid2"><section class="panel"><div class="panel-head"><div><h2>Material movement</h2><p>Daily weight for the selected pickup cohort</p></div><span class="pill gray">kg</span></div><div class="panel-body"><div class="legend"><span><i></i>Collected</span><span><i class="gray"></i>Warehouse received</span></div>${chart(a)}<div class="flow"><div><b>${a.length}</b><span>Collected pickups</span></div><div><b>${a.filter(d=>d.received===null).length}</b><span>Awaiting receipt</span></div><div><b>${a.filter(d=>d.received!==null).length}</b><span>Received loads</span></div><div><b>${a.filter(d=>d.dispatch>0).length}</b><span>Buyer dispatches</span></div></div></div></section><section class="panel"><div class="panel-head"><div><h2>Needs attention</h2><p>${open.length} open exceptions in this view</p></div><button class="link" data-nav="risk">View all ↗</button></div><div class="panel-body">${open.slice(0,3).map(r=>`<div class="riskrow"><div class="riskicon">${ico('risk')}</div><div class="desc"><b>${r.type}</b><p>${r.row.territory} · ${r.detail}</p><button class="link" data-risk="${r.id}">Review ${r.row.id} →</button></div>${status(r.severity)}</div>`).join('')||'<div class="empty">No open exceptions in this selection.</div>'}</div></section></div><section class="panel"><div class="panel-head"><div><h2>Recent collections</h2><p>Open a pickup to see its chain of custody</p></div><button class="link" data-nav="collections">All collections ↗</button></div>${collectionTable([...a].sort((x,y)=>y.day-x.day),6)}</section>`}
function riskView(){const list=risks().filter(r=>riskFilter==='All'||(riskFilter==='Reviewed'?local.reviews[r.id]?.status==='Reviewed':local.reviews[r.id]?.status!=='Reviewed'));return `<div class="banner">${ico('risk')}Risk signals require independent review. Marking an item reviewed does not change weights, payments or balances.</div><section class="panel"><div class="panel-head"><div><h2>Exception queue</h2><p>Assign a reviewer and record the next action</p></div><span class="pill gray">${list.length} items</span></div><div class="subfilter">${['Open','Reviewed','All'].map(s=>`<button class="btn ${riskFilter===s?'active':''}" data-riskfilter="${s}">${s}</button>`).join('')}</div><div class="tablewrap"><table><thead><tr><th>Exception</th><th>Territory / pickup</th><th>Severity</th><th>Exposure estimate*</th><th>Reviewer</th><th>Status</th><th></th></tr></thead><tbody>${list.map(r=>`<tr><td><b>${r.type}</b><small>${r.detail}</small></td><td>${r.row.territory}<small>${r.row.id}</small></td><td>${status(r.severity)}</td><td>${r.value}</td><td>${esc(local.reviews[r.id]?.owner||'Unassigned')}</td><td>${status(local.reviews[r.id]?.status||'Open')}</td><td><button class="link" data-risk="${r.id}">Review ↗</button></td></tr>`).join('')}</tbody></table></div>${!list.length?'<div class="empty">No exceptions in this selection.</div>':''}<div class="tablefoot">*Weight differences valued at purchase rate; payment flags show the transaction amount. These are not confirmed losses and may overlap.</div></section>`}
function stockView(a){const received=a.reduce((s,d)=>s+(d.received||0),0),dispatch=a.reduce((s,d)=>s+d.dispatch,0),awaiting=a.filter(d=>d.received===null).reduce((s,d)=>s+d.kg,0);return `<div class="stats">${stat('Recorded receipts',num(received)+' kg','Selected pickup cohort','stock')}${stat('Dispatched to buyers',num(dispatch)+' kg','Linked buyer shipments','collections')}${stat('Remaining from cohort',num(received-dispatch)+' kg','Receipts less dispatches','weight')}${stat('Awaiting warehouse',num(awaiting)+' kg','Not classified as shortage','risk')}</div><div class="banner">This is a cohort reconciliation, not total warehouse inventory. Opening stock, unrelated receipts and physical counts are outside this demo.</div><section class="panel"><div class="panel-head"><h2>Pickup-to-warehouse reconciliation</h2></div><div class="tablewrap"><table><thead><tr><th>Pickup / material</th><th>Territory</th><th class="num">Collected kg</th><th class="num">Received kg</th><th class="num">Difference kg</th><th class="num">Dispatched kg</th><th class="num">Remaining kg</th></tr></thead><tbody>${a.map(d=>`<tr><td><button class="link" data-pickup="${d.id}">${d.id}</button><small>${d.material}</small></td><td>${d.territory}</td><td class="num">${d.kg}</td><td class="num">${d.received??'Pending'}</td><td class="num">${d.received===null?'—':d.kg-d.received}</td><td class="num">${d.dispatch}</td><td class="num">${d.received===null?'—':d.received-d.dispatch}</td></tr>`).join('')}</tbody></table></div>${!a.length?'<div class="empty">No material records match.</div>':''}</section>`}
function settlementView(a){let v=a.filter(d=>d.payment==='Verified').reduce((s,d)=>s+d.amount,0),p=a.filter(d=>d.payment!=='Verified').reduce((s,d)=>s+d.amount,0),bill=a.reduce((s,d)=>s+d.dispatch*(d.rate+8),0),due=a.reduce((s,d)=>s+(d.buyerPaid?0:d.dispatch*(d.rate+8)),0);let filtered=a.filter(d=>paymentFilter==='All'||d.payment===paymentFilter);return `<div class="stats">${stat('Verified customer payouts',money(v),'Outgoing purchase payments','settlements','good')}${stat('Payouts needing review',money(p),'Pending and mismatch records','risk','warn')}${stat('Buyer invoices',money(bill),'Sales linked to this cohort','audit')}${stat('Buyer receivables',money(due),'Unpaid invoices · not all overdue','settlements')}</div><section class="panel"><div class="panel-head"><div><h2>Customer payout ledger</h2><p>Payment states are simulated; no bank is connected</p></div></div><div class="subfilter">${['All','Verified','Pending','Mismatch'].map(s=>`<button class="btn ${paymentFilter===s?'active':''}" data-paymentfilter="${s}">${s}</button>`).join('')}</div>${collectionTable(filtered)}</section><section class="panel"><div class="panel-head"><h2>Buyer invoices & receipts</h2></div><div class="tablewrap"><table><thead><tr><th>Invoice</th><th>Buyer / territory</th><th class="num">Dispatched</th><th class="num">Invoice amount</th><th>Due date</th><th>Receipt</th></tr></thead><tbody>${a.filter(d=>d.dispatch).map(d=>`<tr><td><button class="link" data-pickup="${d.id}">INV-${d.id.slice(4)}</button></td><td>${d.buyer}<small>${d.territory}</small></td><td class="num">${d.dispatch} kg</td><td class="num">${money(d.dispatch*(d.rate+8))}</td><td>${d.day+2} Sep 2026</td><td>${status(d.buyerPaid?'Paid':'Pending')}</td></tr>`).join('')}</tbody></table></div>${!a.some(d=>d.dispatch)?'<div class="empty">No buyer invoices in this selection.</div>':''}</section>`}
function leads(){return [...baseLeads,...local.leads].filter(d=>($('territory').value==='all'||d.territory===$('territory').value)&&d.created>=29-Number($('period').value)&&Object.values(d).join(' ').toLowerCase().includes($('search').value.trim().toLowerCase()))}
function networkView(a){const ts=names.filter(n=>($('territory').value==='all'||n===$('territory').value)&&(a.some(d=>d.territory===n)||!$('search').value));return `<div class="network">${ts.map((n,i)=>{const list=a.filter(d=>d.territory===n),w=list.reduce((s,d)=>s+d.kg,0),rate=list.length?Math.round(list.filter(d=>d.payment==='Verified').length/list.length*100):0;return `<section class="panel territory"><span class="pill green">Demo operating territory</span><h3>${n}</h3><p>Tier 1 · Franchise ${String(names.indexOf(n)+1).padStart(2,'0')}</p><div class="metricline"><div><b>${num(w)} kg</b><span>Collected</span></div><div><b>${list.length}</b><span>Pickups</span></div></div><div style="display:flex;justify-content:space-between;font-size:11px;color:var(--muted)"><span>Verified payment rate</span><b>${list.length?rate+'%':'No records'}</b></div><div class="progress"><span style="width:${rate}%"></span></div><button class="link" data-territory="${n}" style="margin-top:12px">Explore territory →</button></section>`}).join('')}</div><section class="panel"><div class="panel-head"><div><h2>Partner pipeline</h2><p>Prospects created within the selected period · illustrative identities</p></div><span class="pill gray">${leads().length} prospects</span></div><div class="pipeline">${['New enquiry','Qualified','Discovery visit','Due diligence'].map(s=>`<section class="lane"><h3>${s.toUpperCase()}</h3>${leads().filter(l=>l.stage===s).map(l=>`<button class="lead" data-lead="${esc(l.id)}"><b>${esc(l.name)}</b><span>${esc(l.territory)} · ${esc(l.budget)}</span></button>`).join('')||'<p style="font-size:11px;color:var(--muted)">No prospects</p>'}</section>`).join('')}</div></section>`}
function auditView(){const items=[...local.audit,...baseAudit].filter(d=>Object.values(d).join(' ').toLowerCase().includes($('search').value.trim().toLowerCase()));return `<div class="banner">${ico('audit')}This browser log can be reset or modified. It demonstrates the workflow, not a secure or tamper-proof audit system.</div><section class="panel"><div class="panel-head"><div><h2>Workspace activity</h2><p>Global activity log · search applies; territory and reporting period do not</p></div></div>${items.map(x=>`<div class="auditline"><small>${esc(x.time)}</small><div><b>${esc(x.action)}</b><br><small>${esc(x.actor)}</small></div><span class="pill gray">${esc(x.ref)}</span></div>`).join('')||'<div class="empty">No matching activity.</div>'}</section>`}
function render(){nav();$('crumb').textContent=cfg[current][0];$('title').textContent=cfg[current][1];$('subtitle').textContent=cfg[current][2];const a=rows();$('scope').textContent=current==='audit'?'Global workspace activity · local demonstration history':`${$('territory').value==='all'?'All 5 territories':$('territory').value} · ${$('period').selectedOptions[0].textContent} · ${a.length} matching pickups${$('search').value?' · Search applied':''}`;$('territory').disabled=current==='audit';$('period').disabled=current==='audit';$('view').innerHTML=current==='overview'?overview(a):current==='collections'?`<section class="panel"><div class="panel-head"><div><h2>Collection register</h2><p>Every record links customer payment to material movement</p></div><span class="pill gray">${a.length} pickups</span></div>${collectionTable(a)}</section>`:current==='risk'?riskView():current==='stock'?stockView(a):current==='settlements'?settlementView(a):current==='network'?networkView(a):auditView()}
function go(v){current=v;$('sidebar').classList.remove('open');render()}
function modal(title,body,kicker='TRANSACTION DETAILS'){$('dialogTitle').textContent=title;$('dialogKicker').textContent=kicker;$('dialogBody').innerHTML=body;if(!$('dialog').open)$('dialog').showModal()}
function pickup(id){const d=data.find(d=>d.id===id);if(!d)return;modal(d.id,`<span class="pill gray">${d.territory}</span><dl class="detailgrid"><div><dt>Customer</dt><dd>${d.customer}</dd></div><div><dt>Collected on</dt><dd>${d.day} September 2026</dd></div><div><dt>Collector / vehicle</dt><dd>${d.collector}<br><small>${d.vehicle}</small></dd></div><div><dt>Material / purchase rate</dt><dd>${d.material} · ${money(d.rate)}/kg</dd></div><div><dt>Customer payout</dt><dd>${money(d.amount)} ${status(d.payment)}</dd></div><div><dt>Payment reference</dt><dd>${d.payment==='Verified'?'DEMO-TXN-'+d.id.slice(4):'Verification required'}</dd></div></dl><h3 style="font-size:14px">Chain of custody</h3><div class="timeline"><div class="step"><b>Customer pickup recorded</b><small>${d.kg} kg net · customer confirmation simulated</small></div><div class="step ${d.received===null?'pending':''}"><b>${d.received===null?'Awaiting warehouse receipt':'Warehouse received '+d.received+' kg'}</b><small>${d.received===null?'Receiving weight is not yet recorded':d.kg-d.received?'Difference: '+(d.kg-d.received)+' kg · investigate before adjustment':'Pickup and receipt weights match'}</small></div><div class="step ${!d.dispatch?'pending':''}"><b>${d.dispatch?'Buyer dispatch: '+d.dispatch+' kg':'No buyer dispatch recorded'}</b><small>${d.dispatch?d.buyer+' · '+money(d.dispatch*(d.rate+8)):'Material remains in custody or awaits receipt'}</small></div><div class="step ${!d.dispatch||!d.buyerPaid?'pending':''}"><b>${d.dispatch&&d.buyerPaid?'Buyer payment recorded':'Buyer settlement pending / not applicable'}</b><small>Demonstration records only</small></div></div>${allRisks().filter(r=>r.row.id===id).map(r=>`<button class="btn" data-risk="${r.id}" style="margin:3px">Review ${r.type.toLowerCase()} →</button>`).join('')}<p class="subtitle">No photo, bank or scale integrations are connected in this prototype.</p>`)}
function review(id){const r=allRisks().find(x=>x.id===id);if(!r)return;const saved=local.reviews[id]||{};modal(r.type,`<div class="banner">${r.row.id} · ${r.row.territory} · ${r.detail}</div><p style="font-size:13px">Check the original pickup, receiving weight and payment evidence. Review completion does not confirm fraud or correct a financial balance.</p><form id="reviewForm"><label class="field">Reviewer<select name="owner" required><option value="">Choose a reviewer</option>${['Central finance','Operations lead','Internal audit'].map(x=>`<option ${saved.owner===x?'selected':''}>${x}</option>`).join('')}</select></label><label class="field">Review status<select name="status"><option ${saved.status==='In review'?'selected':''}>In review</option><option ${saved.status==='Reviewed'?'selected':''}>Reviewed</option></select></label><label class="field">Findings / next action<textarea name="note" required minlength="10" maxlength="1000" placeholder="Record evidence checked and the next action…">${esc(saved.note||'')}</textarea></label><p class="formerror" id="reviewError" role="alert"></p><button class="btn primary" type="submit">Save demo review</button></form>`, 'EXCEPTION REVIEW');$('reviewForm').onsubmit=e=>{e.preventDefault();const f=new FormData(e.target),note=String(f.get('note')).trim();if(note.length<10){$('reviewError').textContent='Please add a meaningful note of at least 10 characters.';return}local.reviews[id]={owner:f.get('owner'),status:f.get('status'),note};log(`Exception ${id} marked ${f.get('status')} by ${f.get('owner')}. Note: ${note}`,id);$('dialog').close();render();toast('Review saved locally. Source transactions remain unchanged.')}}
function leadForm(id){const lead=[...baseLeads,...local.leads].find(l=>l.id===id);if(lead){modal(lead.name,`<dl class="detailgrid"><div><dt>Territory</dt><dd>${esc(lead.territory)}</dd></div><div><dt>Stage</dt><dd>${esc(lead.stage)}</dd></div><div><dt>Indicative investment</dt><dd>${esc(lead.budget)}</dd></div><div><dt>Created</dt><dd>${lead.created} Sep 2026</dd></div></dl><p>${esc(lead.note)}</p><p class="subtitle">Demo prospect only. No contact has been made.</p>`,'PARTNER PROSPECT');return}modal('Add a franchise prospect',`<form id="leadForm"><label class="field">Name / business<input name="name" required maxlength="80" placeholder="Prospect or company name"></label><label class="field">Preferred territory<select name="territory">${names.map(n=>`<option>${n}</option>`).join('')}</select></label><label class="field">Stage<select name="stage">${['New enquiry','Qualified','Discovery visit','Due diligence'].map(s=>`<option>${s}</option>`).join('')}</select></label><label class="field">Indicative investment<input name="budget" maxlength="60" placeholder="e.g. ₹15–20 lakh"></label><label class="field">Next action / notes<textarea name="note" maxlength="1000" placeholder="What needs to happen next?"></textarea></label><p id="leadError" class="formerror" role="alert"></p><button class="btn primary">Save demo prospect</button><p class="subtitle">Added to the simulated reporting date, 28 Sep 2026. Stored in this browser only.</p></form>`,'FRANCHISE CRM');$('leadForm').onsubmit=e=>{e.preventDefault();const f=new FormData(e.target),name=String(f.get('name')).trim();if(!name){$('leadError').textContent='Enter a name or business.';return}const d={id:'FR-'+Date.now(),name,territory:f.get('territory'),stage:f.get('stage'),budget:String(f.get('budget')).trim()||'To confirm',note:String(f.get('note')).trim()||'No next action recorded.',created:28};local.leads.push(d);log('Prospect added: '+d.name,d.id);$('dialog').close();$('territory').value='all';$('search').value='';go('network');toast('Prospect saved locally. No message was sent.')}}
function exportCSV(){let headers,records;if(current==='network'){headers=['Prospect ID','Name','Territory','Stage','Investment','Notes'];records=leads().map(l=>[l.id,l.name,l.territory,l.stage,l.budget,l.note])}else if(current==='audit'){headers=['Time','Actor','Action','Reference'];records=[...local.audit,...baseAudit].filter(d=>Object.values(d).join(' ').toLowerCase().includes($('search').value.toLowerCase())).map(d=>[d.time,d.actor,d.action,d.ref])}else if(current==='risk'){headers=['Exception','Pickup','Territory','Type','Severity','Review status','Reviewer'];records=risks().filter(r=>riskFilter==='All'||(riskFilter==='Reviewed'?local.reviews[r.id]?.status==='Reviewed':local.reviews[r.id]?.status!=='Reviewed')).map(r=>[r.id,r.row.id,r.row.territory,r.type,r.severity,local.reviews[r.id]?.status||'Open',local.reviews[r.id]?.owner||''])}else{headers=['Pickup','Date','Territory','Customer','Collected kg','Received kg','Dispatched kg','Customer payout INR','Payment status'];records=rows().filter(d=>current!=='settlements'||paymentFilter==='All'||d.payment===paymentFilter).map(d=>[d.id,d.date,d.territory,d.customer,d.kg,d.received??'',d.dispatch,d.amount,d.payment])}const cell=x=>{let s=String(x);if(/^[=+@\-\t\r]/.test(s))s="'"+s;return '"'+s.replace(/"/g,'""')+'"'};const csv='\ufeff'+[headers,...records].map(r=>r.map(cell).join(',')).join('\r\n');let url=URL.createObjectURL(new Blob([csv],{type:'text/csv;charset=utf-8;'})),a=document.createElement('a');a.href=url;a.download='Scrappy-demo-'+current+'.csv';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);toast(`${records.length} demo records exported${current==='settlements'?' from the customer payout ledger':''}.`)}
document.addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;if(b.dataset.nav)go(b.dataset.nav);if(b.dataset.pickup)pickup(b.dataset.pickup);if(b.dataset.risk)review(b.dataset.risk);if(b.dataset.lead)leadForm(b.dataset.lead);if(b.dataset.territory){$('territory').value=b.dataset.territory;go('overview')}if(b.dataset.riskfilter){riskFilter=b.dataset.riskfilter;render()}if(b.dataset.paymentfilter){paymentFilter=b.dataset.paymentfilter;render()}});
['territory','period'].forEach(id=>$(id).addEventListener('change',render));$('search').addEventListener('input',render);$('newLead').onclick=()=>leadForm();$('export').onclick=exportCSV;$('closeModal').onclick=()=>$('dialog').close();$('dialog').addEventListener('click',e=>{if(e.target===$('dialog')){const r=$('dialog').getBoundingClientRect();if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)$('dialog').close()}});$('openNav').onclick=()=>$('sidebar').classList.add('open');$('closeNav').onclick=()=>$('sidebar').classList.remove('open');document.addEventListener('keydown',e=>{if(e.key==='Escape')$('sidebar').classList.remove('open')});$('reset').onclick=()=>{modal('Reset demo changes?',`<p>This removes prospects and review notes created in this browser. The original demonstration dataset will remain.</p><div class="actions" style="margin-top:22px"><button class="btn" id="cancelReset">Keep changes</button><button class="btn primary" id="confirmReset">Reset demo</button></div>`,'DEMO SETTINGS');$('cancelReset').onclick=()=>$('dialog').close();$('confirmReset').onclick=()=>{local={reviews:{},leads:[],audit:[]};save();$('dialog').close();render();toast('Demo changes reset.')}};render();
</script>
</body></html>
